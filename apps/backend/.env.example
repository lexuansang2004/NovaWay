PORT=3000
NODE_ENV=development
DATABASE_URL=postgres://novaway:novaway@localhost:5433/novaway
JWT_SECRET=change-me-to-a-random-secret-at-least-16-chars
JWT_EXPIRES_IN=7d
WEB_ORIGIN=http://localhost:5173
# docs/architecture/TDR-routing-engine.md — 'osrm' hits a public demo
# server, dev/test only. Leave as 'mock' unless you know what you're doing.
ROUTING_PROVIDER=mock
ROUTING_ENGINE_BASE_URL=https://router.project-osrm.org
ROUTING_ENGINE_TIMEOUT_MS=3000
VERIFICATION_VALIDITY_MINUTES=5
# docs/architecture/TDR-biometric-provider-spike.md — 'aws-rekognition' makes
# real, billed AWS API calls. Leave as 'mock' unless AWS credentials are
# configured (standard AWS SDK credential chain — AWS_ACCESS_KEY_ID/
# AWS_SECRET_ACCESS_KEY env vars, ~/.aws/credentials, or an IAM role) AND
# the ToS/DPA opt-out of AWS's default video retention has been confirmed
# for this environment.
BIOMETRIC_PROVIDER=mock
AWS_REGION=us-east-1
AWS_REKOGNITION_LIVENESS_MIN_CONFIDENCE=90
