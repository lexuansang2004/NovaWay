# Keep Unity text assets stable when moving between Windows and macOS.
*.cs text eol=lf
*.cginc text eol=lf
*.hlsl text eol=lf
*.shader text eol=lf
*.shadergraph text eol=lf
*.shadersubgraph text eol=lf
*.json text eol=lf
*.inputactions text eol=lf
*.asmdef text eol=lf
*.asmref text eol=lf
*.meta text eol=lf
*.unity text eol=lf
*.prefab text eol=lf
*.asset text eol=lf
*.mat text eol=lf
*.controller text eol=lf
*.anim text eol=lf
*.overrideController text eol=lf
*.physicMaterial text eol=lf
*.physicsMaterial2D text eol=lf
*.renderTexture text eol=lf
*.spriteatlas text eol=lf
*.terrainlayer text eol=lf
*.guiskin text eol=lf
*.preset text eol=lf
*.playable text eol=lf
*.mask text eol=lf
*.brush text eol=lf
*.flare text eol=lf
*.fontsettings text eol=lf
*.wlt text eol=lf
*.txt text eol=lf

